           O1--C3         1.4340(5)    -0.00024(17)

  C--C     C2--C3         1.4571(6)       0.0000(2)

  C--H     C2--H2B         1.081(8)       -0.012(4)
           C2--H2A         1.066(7)       -0.008(4)
           C3--H3A         1.103(8)       -0.012(3)
           C3--H3B         1.091(9)       -0.016(3)
